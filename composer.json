{
  "name": "morphp/medas-http-request-handler",
  "description": "Medas HTTP request handler",
  "keywords": [
    "http"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "require": {
    "ext-mbstring": "*",
    "morphp/medas-core": "^4",
    "morphp/medas-error-reporting": "^4",
    "morphp/medas-files": "^3",
    "morphp/medas-json": "^3",
    "php": "^8.4",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "morphp/medas-events": "^3",
    "morphp/medas-object-instantiator": "^4",
    "morphp/medas-service-manager": "^4",
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Medas\\HttpRequestHandler\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Medas\\HttpRequestHandlerTest\\": "tests/"
    }
  }
